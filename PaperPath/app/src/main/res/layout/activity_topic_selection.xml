<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayoutTopicSelection"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    tools:ignore="MissingClass"
    tools:context=".TopicSelectionActivity">

    <ScrollView
        android:id="@+id/scrollViewTopics"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomButtonContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="32dp"
            android:paddingBottom="24dp">

            <!-- Logo Header -->
            <FrameLayout
                android:id="@+id/logoContainer"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_circle_logo"
                android:elevation="3dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/cd_logo"
                    android:src="@drawable/ic_smartcfp_logo" />
            </FrameLayout>

            <!-- Screen Title -->
            <TextView
                android:id="@+id/tvTopicTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/topic_selection_title"
                android:textColor="@color/dark_blue_primary"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/tvTopicSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/topic_selection_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <!-- Selection Hint Badge -->
            <TextView
                android:id="@+id/tvTopicHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp"
                android:text="@string/topic_selection_hint"
                android:textColor="@color/dark_blue_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

