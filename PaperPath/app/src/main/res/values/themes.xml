<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme using MaterialComponents Dark Mode -->
    <style name="Base.Theme.PaperPath" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Deep Space Dark Brand Colors -->
        <item name="colorPrimary">@color/gradient_purple_start</item>
        <item name="colorPrimaryVariant">@color/accent_electric_purple</item>
        <item name="colorOnPrimary">@color/text_white</item>
        <item name="colorSecondary">@color/gradient_blue_end</item>
        <item name="colorSecondaryVariant">@color/accent_vibrant_blue</item>
        <item name="colorOnSecondary">@color/text_white</item>
        
        <!-- Window & System Bars -->
        <item name="android:windowBackground">@color/bg_space_dark</item>
        <item name="android:colorBackground">@color/bg_space_dark</item>
        <item name="android:statusBarColor">@color/bg_space_dark</item>
        <item name="android:navigationBarColor">@color/bg_bottom_nav</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.PaperPath" parent="Base.Theme.PaperPath" />

    <!-- Gradient CTA Button Style -->
    <style name="Widget.SmartCFP.Button.Gradient" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/bg_btn_gradient</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/text_white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="elevation">4dp</item>
    </style>

    <!-- Google SSO Button Style -->
    <style name="Widget.SmartCFP.Button.Google" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/bg_btn_google</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/text_white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>